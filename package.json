{
  "name": "pdv-restaurante",
  "version": "0.3.2",
  "description": "PDV Restaurante - pedidos, cozinha e pagamentos",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "test": "node --test --test-timeout=120000 --test-reporter=spec test/*.test.js",
    "dist": "electron-builder --config electron-builder.config.js --win --publish never",
    "sync:postgres": "node scripts/sync-postgres.js",
    "sync:ddl": "node scripts/sync-postgres.js --ddl",
    "versao:patch": "npm version patch --no-git-tag-version",
    "versao:minor": "npm version minor --no-git-tag-version"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "whatsapp-web.js": "^1.34.7"
  }
}
